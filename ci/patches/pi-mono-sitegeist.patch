+export type SelectableThinkingLevel = "off" | ThinkingLevel;
+const THINKING_LEVELS: SelectableThinkingLevel[] = ["off", "minimal", "low", "medium", "high", "xhigh"];
+
+/** Levels that the current runtime can actually request for this model. */
+export function getSelectableThinkingLevels<TApi extends Api>(
+	model: Model<TApi> | null | undefined,
+): SelectableThinkingLevel[] {
+	if (!model?.reasoning) return ["off"];
+	return THINKING_LEVELS.filter((level) => {
+		if (level === "off") return true;
+		if (model.thinkingLevelMap?.[level] === null || model.thinkingLevelMap?.[level] === "none") return false;
+		if (level !== "xhigh") return true;
+		if (!supportsXhigh(model)) return false;
+		// The older Anthropic transport only handles xhigh on Opus 4.6 (as adaptive max).
+		return model.api !== "anthropic-messages" || model.id.includes("opus-4-6") || model.id.includes("opus-4.6");
+	});
+}
+
+/** Apply an explicit pi.dev effort alias without mutating the selected UI level. */
+export function mapReasoningLevel<TApi extends Api>(
+	model: Model<TApi>,
+	level: "off" | ThinkingLevel | undefined,
+): "none" | ThinkingLevel | undefined {
+	if (!level || level === "off") {
+		return model.thinkingLevelMap?.off === "none" ? "none" : undefined;
+	}
+	const mapped = model.thinkingLevelMap?.[level];
+	return mapped === null || mapped === "none" ? undefined : (mapped ?? level);
+}
